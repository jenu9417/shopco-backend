# --- App ---
ENVIRONMENT=local            # local | test | staging | production
DEBUG=false
DOCS_ENABLED=true            # serves /docs, /redoc, /openapi.json

# --- Database (docker-compose overrides the host for the api container) ---
DATABASE_URL=postgresql+asyncpg://ecom:ecom@localhost:5432/ecom
DB_ECHO=false

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS / cookies (comma-separated origins; set to your storefront + admin URLs) ---
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false          # MUST be true in staging/production (HTTPS)
COOKIE_SAMESITE=lax          # lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_DOMAIN=

RATE_LIMIT_ENABLED=true

# --- Seed data (scripts/seed.py) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
